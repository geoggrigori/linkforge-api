# Copy to .env and adjust. All values have sensible local defaults.

# REQUIRED in production: a long, random secret used to sign JWTs.
SECRET_KEY=dev-secret-change-me

# How long an access token stays valid (minutes).
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database connection string (SQLite by default; swap for Postgres in prod).
DATABASE_URL=sqlite:///./linkforge.db

# Public base URL used to build short links.
BASE_URL=http://localhost:8000

# Rate limiting: max requests per window, per client IP.
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# Redirect cache.
CACHE_TTL_SECONDS=300
CACHE_MAX_SIZE=1024
